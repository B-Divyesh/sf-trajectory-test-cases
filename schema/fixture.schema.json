{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajectory-test-cases.sociobot.in/fixture.schema.json",
  "title": "Trajectory Test Case",
  "description": "A versioned partial-order fixture for a scrubbed tool-event trajectory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "expect"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "expect": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectedAction" }
    },
    "forbid": {
      "type": "array",
      "items": { "$ref": "#/$defs/selector" }
    },
    "allowUnmatched": { "type": "boolean", "default": true }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["call", "result", "error"], "default": "call" },
        "args": true
      }
    },
    "expectedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["call", "result", "error"], "default": "call" },
        "args": true,
        "after": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "count": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
