{
  "name": "trajectory-test-cases",
  "version": "0.1.0",
  "description": "Deterministic partial-order assertions for tool-calling agent trajectories",
  "type": "module",
  "license": "MIT",
  "author": "Sociobot (Param Factory)",
  "homepage": "https://trajectory-test-cases.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-trajectory-test-cases.git"
  },
  "bugs": {
    "url": "https://github.com/B-Divyesh/sf-trajectory-test-cases/issues"
  },
  "keywords": ["agents", "testing", "tool-calling", "ci", "trajectory"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": { "ttc": "./dist/cli.cjs" },
  "files": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts", "dist/cli.cjs", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:lib": "tsup",
    "build:site": "vite build --config vite.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "npm run build:site && playwright test",
    "test": "npm run build:lib && npm run test:unit && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.7",
    "tsup": "8.3.6",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "2.1.8"
  }
}
