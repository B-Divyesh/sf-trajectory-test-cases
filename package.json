{
  "name": "trajectory-test-cases",
  "version": "0.1.0",
  "description": "Deterministic partial-order assertions for tool-calling agent trajectories",
  "type": "module",
  "license": "MIT",
  "author": "Sociobot (Param Factory)",
  "homepage": "https://trajectory-test-cases.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-trajectory-test-cases.git"
  },
  "bugs": {
    "url": "https://github.com/B-Divyesh/sf-trajectory-test-cases/issues"
  },
  "keywords": [
    "agents",
    "testing",
    "tool-calling",
    "ci",
    "trajectory"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fixture.schema.json": "./schema/fixture.schema.json"
  },
  "bin": {
    "ttc": "./dist/cli.cjs"
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/cli.cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "schema/fixture.schema.json"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:lib": "tsup",
    "build:site": "vite build --config vite.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "npm run build:lib && npm run build:site && playwright test",
    "test:claims": "npm run test:browser -- tests/browser/claims.spec.ts",
    "test": "npm run build:lib && npm run test:unit && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/verify-claims.mjs",
    "verify:url": "./verify-url.sh",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.10.13",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": { "esbuild": "0.28.2" }
}
